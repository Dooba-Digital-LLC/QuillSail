include README.md LICENSE CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md
include Dockerfile compose.yaml .dockerignore .gitignore .gitattributes .editorconfig
recursive-include .github *.yml *.md
recursive-include docs *.md
recursive-include docs *.json
recursive-include deploy *.service
recursive-include deploy *.py *.sh *.example
recursive-include scripts *.py *.sh
recursive-include assets *.svg *.png *.md
recursive-include tests *.py
prune .validation
prune .venv
prune instance
prune data
prune backups
prune build
global-exclude __pycache__ *.py[cod] .DS_Store .env *.env client_secret_*.json *credentials*.json *.pem *.key *.db *.sqlite*
exclude CLAUDE.md

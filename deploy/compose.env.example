# Copy this file to deploy/compose.env; that local file is ignored by Git.
# This example contains no credentials. The init service generates and stores
# a stable secret in the protected configuration on the persistent volume.
COPYDESK_BASE_URL=http://localhost:8080
COPYDESK_PORT=8080
COPYDESK_PROXY_HOPS=0
COPYDESK_WEB_WORKERS=2

# For production, use your HTTPS URL, including any path prefix, and set the
# exact number of trusted reverse proxies (normally 1).
# COPYDESK_BASE_URL=https://blog.example.com
# COPYDESK_PROXY_HOPS=1

# Optional: use a published release image instead of building locally.
# Replace YOUR_ACCOUNT with the repository's actual GitHub owner.
# COPYDESK_IMAGE=ghcr.io/YOUR_ACCOUNT/copydesk:1.3.0

[Unit]
Description=QuillSail Cloudflare tunnel
After=network-online.target copydesk.service
Wants=network-online.target

[Service]
Type=simple
User=copydesk
Group=copydesk
WorkingDirectory=/var/lib/copydesk
ExecStart=/opt/copydesk/.venv/bin/quillsail --config /etc/copydesk/copydesk.toml tunnel run
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/copydesk
ProtectHome=true

[Install]
WantedBy=multi-user.target

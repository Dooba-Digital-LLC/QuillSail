[Unit]
Description=QuillSail blog and newsletter web application
After=network.target

[Service]
Type=simple
User=copydesk
Group=copydesk
WorkingDirectory=/var/lib/copydesk
Environment=COPYDESK_CONFIG=/var/lib/copydesk/copydesk.toml
ExecStart=/opt/copydesk/current/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - copydesk.wsgi:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/copydesk

[Install]
WantedBy=multi-user.target
